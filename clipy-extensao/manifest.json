{
  "manifest_version": 3,
  "name": "Clipy — o ajudante que ninguém pediu",
  "version": "1.1.0",
  "description": "Um clipe de papel que aparece por cima de qualquer site e REAGE: comenta o site, entra em pânico num 404, fica tonto se você sacudir ele, reclama quando você fecha uma aba e fica entediado se você parar. Faz conta de verdade. Não manda nada pra lugar nenhum.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ouvidor.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "js/*.js",
        "comentarios.js",
        "reacoes.js",
        "mundo.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clipy",
    "default_icon": {
      "48": "icones/icone-48.png",
      "192": "icones/icone-192.png"
    }
  },
  "icons": {
    "48": "icones/icone-48.png",
    "192": "icones/icone-192.png",
    "512": "icones/icone-512.png"
  }
}