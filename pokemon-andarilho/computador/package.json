{
  "name": "pokemon-andarilho",
  "version": "1.1.1",
  "description": "Um Pokémon 3D que fica andando pela tela do computador, por cima de tudo.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prestart": "node copiar.js",
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^44.5.1"
  },
  "author": "Jojo e Claude",
  "build": {
    "appId": "com.jojo.pokemonandarilho",
    "productName": "Pokemon Andarilho",
    "files": [
      "main.js",
      "preload.js",
      "palco.html",
      "palco.js",
      "config.html",
      "icone.png",
      "extensao/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icone-256.png"
    },
    "portable": {
      "artifactName": "PokemonAndarilho.exe"
    }
  }
}
