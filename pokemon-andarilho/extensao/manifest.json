{
  "manifest_version": 3,
  "name": "Pokémon Andarilho",
  "version": "2.0.0",
  "description": "Um Pokémon 3D que fica andando, pulando e dormindo por cima de qualquer site. Dá pra arrastar, jogar longe e fazer carinho. Escolha entre os 1025!",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["nomes.js", "andarilho.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pokémon Andarilho",
    "default_icon": { "48": "icones/icone-48.png", "128": "icones/icone-128.png" }
  },
  "icons": { "48": "icones/icone-48.png", "128": "icones/icone-128.png" }
}
